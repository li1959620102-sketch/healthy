# AI 智参平台 · 环境变量示例（复制为 .env 后填入真实值；.env 不入库）

# DeepSeek API 配置（统一使用 OpenAI 格式）
OPENAI_API_KEY=<openai_api_key>
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama配置
OLLAMA_BASE_URL="http://localhost:11434"  # 改成正确端口
#LLM_MODEL="qwen3:4b"
LLM_MODEL="qwen3:0.6b"
#EMBEDDING_MODEL="nomic-embed-text"
#MILVUS_DIM=768
EMBEDDING_MODEL="bge-m3"
MILVUS_DIM=1024

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DEFAULT_COLLECTION=ai_health_kb_v1

# redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=10
REDIS_URL="redis://127.0.0.1:6380/10"
REDIS_MAX_CONNECTIONS=1000
REDIS_SOCKET_TIMEOUT=30
REDIS_SOCKET_CONNECT_TIMEOUT=5 # 连接建立超时时间（秒）

MONGO_DB_HOST="www.wolindata.com"
MONGO_DB_PORT=27017
MONGO_DB_NAME="tws"
MONGO_DB_USER="mongo_zCrxDG"
MONGO_DB_PASSWORD=<mongo_db_password>
MONGO_URI=<mongo_uri>

MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY=<minio_access_key>
MINIO_SECRET_KEY=<minio_secret_key>
MINIO_BUCKET="vanna-training-data"
MINIO_SECURE=False

KB_BUCKET_NAME="knowledge-base"

MYSQL_USER=root
MYSQL_PASSWORD=<mysql_password>
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=test_db
MYSQL_URI=<mysql_uri>

DIFY_API_KEY=<dify_api_key>
WORKFLOW_ID=workflow-49b871f9-236a-4c7f-bec1-c552b45480f2
#DIFY_BASE_URL=http://120.79.169.112:18001
DIFY_BASE_URL=http://127.0.0.1:80
#DIFY_BASE_URL=http://192.168.48.149:80
CHAT_MESSAGES="${DIFY_BASE_URL}/v1/chat-messages"
DIFY_TIME_OUT=600

# 环境设置
ENV=production
SECRET_KEY=<至少32位随机密钥>
CORS_ORIGINS=https://your-domain.example
# 演示账号 demo/123456 —— 默认关闭（弱口令）；仅本地调试才设为 true
INIT_DEMO_USER=false
LLM_STRATEGY="ollama"
EMBEDDING_STRATEGY="ollama"
#LLM_STRATEGY="silicon_flow"
#EMBEDDING_STRATEGY="silicon_flow"
SILICON_FLOW_API_KEY=<silicon_flow_api_key>

SILICON_FLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICON_FLOW_LLM_URL="https://api.siliconflow.cn/v1/chat/completions"
SILICON_FLOW_EMBEDDING_URL="https://api.siliconflow.cn/v1/embeddings"
SILICON_FLOW_LLM_MODEL="deepseek-ai/DeepSeek-R1"
SILICON_FLOW_EMBEDDING_MODEL="BAAI/bge-large-zh-v1.5"
SILICON_FLOW_RERANK="BAAI/bge-reranker-v2-m3"

# 新增策略配置
# LLM_STRATEGY: str = "silicon_flow"  # 或 "silicon_flow"
# EMBEDDING_STRATEGY: str = "silicon_flow"  # 或 "silicon_flow"
#LLM_STRATEGY="ollama"         # "ollama"或 "silicon_flow"
#EMBEDDING_STRATEGY= "ollama"  # "ollama"或 "silicon_flow"
#接入模型是ollama、deepseek、silicon_flow
LLM_ENV="ollama"

# ---------- 短信验证码（腾讯云短信；不填则发码接口返回“未配置”） ----------
SMS_PROVIDER=tencent
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_CODE_TTL=300
SMS_RESEND_INTERVAL=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_DEMO_MODE=false

# ---------- 邮箱验证码（SMTP，FR-U-01 邮箱注册）----------
# 缺 MAIL_HOST / MAIL_USER / MAIL_PASSWORD 任一项即视为"未配置"，
# /auth/email/send 会返回明确错误，**不会伪造发送成功**。
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_TIMEOUT=10
EMAIL_CODE_TTL=300
EMAIL_RESEND_INTERVAL=60
EMAIL_CODE_MAX_ATTEMPTS=5
# 邮箱演示模式：仅本地联调可开（验证码回传前端并明示"演示模式"）。
# ⚠️ ENV=production 时开启会导致启动直接失败（app/config.py::validate_runtime_settings）。
MAIL_DEMO_MODE=false

# RAG 检索阈值（COSINE，低于则视为知识库无相关内容）
KB_MIN_SIMILARITY=0.55
